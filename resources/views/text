        string avatar_path
        timestamp created_at
    }

    CATEGORIES {
        bigint id PK
        string name
        string slug UK
        string icon
        int sla_hours
        timestamp created_at
    }

    TICKETS {
        bigint id PK
        bigint user_id FK "Cascade"
        bigint category_id FK "Restrict"
        bigint assigned_agent_id FK "NullOnDelete"
        string subject
        text description
        string location
        string evidence_path
        enum priority "low, medium, high, urgent"
        enum status "open, assigned, in_progress, resolved, closed"
        timestamp eta_timestamp
        timestamp created_at
    }

    SHIFTS {
        bigint id PK
        bigint agent_id FK "Cascade"
        string workspace_name
        timestamp start_time
        timestamp end_time
        timestamp created_at
    }

    TICKET_UPDATES {
        bigint id PK
        bigint ticket_id FK "Cascade"
        string status_from
        string status_to
        text comment
        timestamp created_at
    }

    NOTIFICATIONS {
        bigint id PK
        bigint user_id FK "Cascade"
        string title
        text message
        boolean is_read
        enum type "system, ticket_update, alert"
        timestamp created_at
    }

    ANALYTICS_SNAPSHOTS {
        bigint id PK
        date snapshot_date UK
        int total_tickets_created
        int total_tickets_resolved
        int active_agents_count
        decimal avg_resolution_hours
        int sla_breaches
        timestamp created_at
    }

